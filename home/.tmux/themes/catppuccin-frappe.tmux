#!/usr/bin/env bash
set -g mode-style "fg=#232634,bg=#b5bfe2"
set -g message-style "fg=#232634,bg=#b5bfe2"
set -g message-command-style "fg=#232634,bg=#b5bfe2"
set -g pane-border-style "fg=#a5adce"
set -g pane-active-border-style "fg=#8caaee"
set -g status "on"
set -g status-justify "left"
set -g status-style "fg=#b5bfe2,bg=#232634"
set -g status-left-length "100"
set -g status-right-length "100"
set -g status-left-style NONE
set -g status-right-style NONE
set -g status-left "#[fg=#232634,bg=#8caaee,bold] #S #[fg=#8caaee,bg=#232634,nobold,nounderscore,noitalics]"
set -g status-right "#[fg=#232634,bg=#232634,nobold,nounderscore,noitalics]#[fg=#8caaee,bg=#232634] #{prefix_highlight} #[fg=#b5bfe2,bg=#232634,nobold,nounderscore,noitalics]#[fg=#232634,bg=#b5bfe2] %Y-%m-%d  %I:%M %p #[fg=#8caaee,bg=#b5bfe2,nobold,nounderscore,noitalics]#[fg=#232634,bg=#8caaee,bold] #h "
setw -g window-status-activity-style "underscore,fg=#949cbb,bg=#232634"
setw -g window-status-separator ""
setw -g window-status-style "NONE,fg=#949cbb,bg=#232634"
setw -g window-status-format "#[fg=#232634,bg=#232634,nobold,nounderscore,noitalics]#[default] #I  #W #F #[fg=#232634,bg=#232634,nobold,nounderscore,noitalics]"
setw -g window-status-current-format "#[fg=#232634,bg=#b5bfe2,nobold,nounderscore,noitalics]#[fg=#232634,bg=#b5bfe2,bold] #I  #W #F #[fg=#b5bfe2,bg=#232634,nobold,nounderscore,noitalics]"
